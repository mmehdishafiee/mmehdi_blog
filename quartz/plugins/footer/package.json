{
  "name": "custom-footer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild components.tsx --bundle --format=esm --platform=node --target=es2022 --jsx=automatic --jsx-import-source=preact --external:preact --external:preact/* --external:@quartz-community/* --outfile=dist/components.js"
  },
  "exports": {
    ".": "./dist/components.js",
    "./components": "./dist/components.js"
  },
  "peerDependencies": {
    "preact": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "quartz": {
    "name": "custom-footer",
    "displayName": "Custom Footer",
    "description": "Site footer with links, without version or year.",
    "version": "1.0.0",
    "category": "component",
    "defaultEnabled": true,
    "components": {
      "Footer": {
        "name": "custom-footer",
        "displayName": "Footer",
        "description": "Site footer with links.",
        "version": "1.0.0",
        "defaultPosition": "footer",
        "defaultPriority": 50
      }
    }
  }
}
