{
  "name": "latest-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild components.tsx --bundle --format=esm --platform=node --target=es2022 --jsx=automatic --jsx-import-source=preact --external:preact --external:preact/* --external:@quartz-community/* --outfile=dist/components.js"
  },
  "exports": {
    ".": "./dist/components.js",
    "./components": "./dist/components.js"
  },
  "peerDependencies": {
    "preact": "*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "quartz": {
    "name": "latest-notes",
    "displayName": "Latest Notes",
    "description": "Homepage module listing the ten most recent notes.",
    "version": "1.0.0",
    "category": "component",
    "defaultEnabled": true,
    "components": {
      "LatestNotes": {
        "name": "latest-notes",
        "displayName": "Latest Notes",
        "description": "Homepage module listing the ten most recent notes.",
        "version": "1.0.0",
        "defaultPosition": "beforeBody",
        "defaultPriority": 8
      }
    }
  }
}