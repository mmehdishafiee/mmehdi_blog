{
    "name":  "ziscus-ui",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "build":  "esbuild components.tsx --bundle --format=esm --platform=node --target=es2022 --jsx=automatic --jsx-import-source=preact --external:preact --external:preact/* --outfile=dist/components.js"
                },
    "exports":  {
                    ".":  "./dist/components.js",
                    "./components":  "./dist/components.js"
                },
    "dependencies":  {
                         "esbuild":  "^0.28.1"
                     },
    "peerDependencies":  {
                             "preact":  "*"
                         },
    "quartz":  {
                   "name":  "ziscus-ui",
                   "displayName":  "Ziscus Comments UI",
                   "description":  "Static Ziscus comment section for Quartz.",
                   "version":  "0.1.0",
                   "category":  "component",
                   "components":  {
                                      "ZiscusComments":  {
                                                             "name":  "ziscus-comments",
                                                             "displayName":  "Ziscus Comments",
                                                             "description":  "Static Ziscus comments section.",
                                                             "version":  "0.1.0"
                                                         }
                                  }
               }
}
